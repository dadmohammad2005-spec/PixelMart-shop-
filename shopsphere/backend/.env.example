# ==========================================
# SHOPSPHERE ENVIRONMENT CONFIGURATION (EXAMPLE)
# Copy this file to .env and customize secrets
# ==========================================

# Django Security
DJANGO_SECRET_KEY=your-super-secret-django-key-replace-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database Configuration (Defaults to SQLite in local dev if not postgresql)
DB_ENGINE=sqlite3
# For PostgreSQL in production:
# DB_ENGINE=postgresql
# DB_NAME=shopsphere_db
# DB_USER=shopsphere_user
# DB_PASSWORD=your_secure_password
# DB_HOST=localhost
# DB_PORT=5432

# CORS & CSRF Trusted Origins (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5000,http://localhost:5500,http://localhost:8000,http://127.0.0.1:3000,http://127.0.0.1:5000,http://127.0.0.1:5500,http://127.0.0.1:8000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:5000,http://localhost:5500,http://localhost:8000,http://127.0.0.1:3000,http://127.0.0.1:5000,http://127.0.0.1:5500,http://127.0.0.1:8000

# Stripe Payment Test Mode Keys
STRIPE_PUBLIC_KEY=pk_test_placeholder_key
STRIPE_SECRET_KEY=sk_test_placeholder_key
STRIPE_WEBHOOK_SECRET=whsec_placeholder_secret

# Email Configuration (for password reset and order notifications)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=noreply@example.com
EMAIL_HOST_PASSWORD=your_smtp_password
DEFAULT_FROM_EMAIL=ShopSphere <noreply@shopsphere.example.com>
